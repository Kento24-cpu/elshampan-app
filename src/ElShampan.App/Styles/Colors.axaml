<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BrushTotal" Color="DarkGreen" />
    <SolidColorBrush x:Key="BrushStockBajoBg" Color="Orange" />
    <SolidColorBrush x:Key="BrushStockBajoFg" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="BrushInactivoBg" Color="LightGray" />
    <SolidColorBrush x:Key="BrushInactivoFg" Color="#FF404040" />
</ResourceDictionary>
