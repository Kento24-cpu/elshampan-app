<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ElShampan.App.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://ElShampan.App/Styles/AppStyles.axaml" />
    </Application.Styles>
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ElShampan.App/Styles/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="SystemControlBackgroundAltHighBrush" Color="#FFFCF6" />
            <SolidColorBrush x:Key="SystemControlBackgroundChromeMediumBrush" Color="#F3EDE1" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
