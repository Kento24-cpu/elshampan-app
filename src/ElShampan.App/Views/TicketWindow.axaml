<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ElShampan.App.Views.TicketWindow"
        Title="Ticket de venta"
        Width="380" Height="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="*,Auto" Margin="12">
        <TextBox x:Name="VistaPrevia" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Courier New,monospace" FontSize="9" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="GuardarPdf" Content="Guardar PDF" Click="OnGuardarPdf" MinWidth="110" />
            <Button x:Name="Imprimir" Content="Imprimir..." Click="OnImprimir" MinWidth="110" />
        </StackPanel>
    </Grid>
</Window>
