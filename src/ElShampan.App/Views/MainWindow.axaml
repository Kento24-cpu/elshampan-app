<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ElShampan.App.Views.MainWindow"
        Title="ElShampan - Sistema de venta de licor"
        Width="1000" Height="640"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Grid ColumnDefinitions="230,*">
        <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="16,20" BoxShadow="2 0 6 0 #22000000">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="ElShampan" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="Usuario" FontSize="12" TextWrapping="Wrap" />
                    <Separator Margin="0,14" />
                    <StackPanel x:Name="Nav" Spacing="6" />
                </StackPanel>
                <Button DockPanel.Dock="Bottom" x:Name="CerrarSesion" Content="Cerrar sesión"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                        Click="OnCerrarSesion" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,Auto">
            <Border Padding="20">
                <TextBlock x:Name="Bienvenida" Text="Seleccione un módulo del menú lateral."
                           VerticalAlignment="Center" HorizontalAlignment="Center"
                           Opacity="0.6" FontSize="16" />
            </Border>
            <Border Grid.Row="1" Padding="12,6"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">
                <TextBlock x:Name="Estado" FontSize="12" />
            </Border>
        </Grid>
    </Grid>
</Window>
